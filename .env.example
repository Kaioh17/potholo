# Copy to .env and fill in. .env is gitignored, never commit it.
# docker compose reads this file for the ${...} values in docker-compose.yml.

# Chicago 311 Open311 API key. Needed only to actually file a pothole report.
# Without it the API still builds the request but cannot send it.
CHI311_API_KEY=

# Claude API key. Nothing in the code reads it yet.
CLAUDE_API_KEY=

# Optional API settings. The API reads this file itself when run outside Docker.
# Defaults are in api/app/config.py. Compose sets the production values.
# POTHOLO_ENVIRONMENT=development   (development or production; production hides /docs)
# POTHOLO_CORS_ORIGINS=["https://potholo.usemaison.io"]
# POTHOLO_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
# POTHOLO_GEOCODER_USER_AGENT=Potholo/0.1 (https://potholo.usemaison.io)
# POTHOLO_DATABASE_URL=sqlite:////data/potholo.db

# Web build only (Vite bakes it into the bundle). Compose sets it as a build arg.
# VITE_API_URL=https://api-potholo.usemaison.io
