# Copy to .env and fill in. .env is gitignored, never commit it.
# docker compose reads this file for the ${...} values in docker-compose.yml.

# Chicago 311 Open311 API key. Needed only to actually file a pothole report.
# Without it the API still builds the request but cannot send it.
CHI311_API_KEY=

# Claude API key. Powers the plain-language summary on the Try page.
# Without it, that summary falls back to deterministic text built from the
# same numbers.
CLAUDE_API_KEY=

# API environment: "development" or "production". Production hides /docs.
# Compose passes this straight to the API container; unset falls back to
# production there. The API also reads this file itself when run outside
# Docker, where the default (api/app/config.py) is development.
POTHOLO_ENVIRONMENT=production

# Origins allowed to call the API, as a JSON array. Compose passes this
# straight to the API container; unset falls back to the production origin.
POTHOLO_CORS_ORIGINS=["https://potholo.usemaison.io"]

# Remaining API settings. The API reads this file itself when run outside
# Docker. Defaults are in api/app/config.py; Compose hardcodes the production
# values for these rather than reading them from here.
# POTHOLO_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
# POTHOLO_GEOCODER_USER_AGENT=Potholo/0.1 (https://potholo.usemaison.io)
# POTHOLO_DATABASE_URL=sqlite:////data/potholo.db

# Web build only (Vite bakes it into the bundle at build time, so this can't
# change without a rebuild). Compose passes it as a build arg; unset falls
# back to the exposed production API domain.
VITE_API_URL=https://api-potholo.usemaison.io

# Stadia Maps API key, for the Forecast page's basemap tiles. Free tier, but
# tile.openstreetmap.org blocks direct hotlinking from a deployed app, so this
# is required in production. Get one at https://client.stadiamaps.com and lock
# it to the production domain there.
# VITE_STADIA_API_KEY=
